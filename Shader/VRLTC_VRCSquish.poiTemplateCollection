#ifdef POI_SQUISH
	#define VRCSQUISH_SELF_HIDE
	#define VRCSQUISH_NEAR_BASE 0.001
	#define VRCSQUISH_NEAR_STEP 0.0000002

	float VRCSquishCameraSlot()
	{
		if (unity_OrthoParams.w < 0.5) return -1;
		float slot = (_ProjectionParams.y - VRCSQUISH_NEAR_BASE) / VRCSQUISH_NEAR_STEP;
		float nearest = round(slot);
		return abs(slot - nearest) < 0.25 ? nearest : -1;
	}

	bool VRCSquishIsOwnCamera()
	{
		float slot = VRCSquishCameraSlot();
		return _SquishId > 0.5 && slot >= 0 && floor(slot / 4.0) == round(_SquishId);
	}

	bool VRCSquishIsRegionCamera(int region)
	{
		return _SquishId > 0.5 && VRCSquishCameraSlot() == round(_SquishId) * 4.0 + region;
	}

	bool VRCSquishHideSelf()
	{
		return _SquishSelf < 0.5 && VRCSquishIsOwnCamera();
	}
#endif

#if defined(POI_SQUISH) && (defined(PROP_SQUISHDATA) || !defined(OPTIMIZER_ENABLED))
	#define POI_SQUISH_ACTIVE
	#define VRCSQUISH_NONE -1000000.0
	#define VRCSQUISH_FAR 1000000.0

	struct VRCSquishVertex
	{
		float3 pos;
		float3 normal;
		float3 tangent;
		int region;
		float mask;
	};

	struct VRCSquishField
	{
		float disp;
		float2 grad;
		float nearest;
	};

	void VRCSquishBSpline(float t, out float4 w, out float4 dw)
	{
		float it = 1.0 - t;
		float t2 = t * t;
		float t3 = t2 * t;
		w = float4(it * it * it, 3.0 * t3 - 6.0 * t2 + 4.0, -3.0 * t3 + 3.0 * t2 + 3.0 * t + 1.0, t3) / 6.0;
		dw = float4(-0.5 * it * it, 1.5 * t2 - 2.0 * t, -1.5 * t2 + t + 0.5, 0.5 * t2);
	}

	float3 VRCSquishOctDecode(float2 f)
	{
		float3 n = float3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
		float t = saturate(-n.z);
		n.xy += n.xy >= 0.0 ? -t : t;
		return normalize(n);
	}

	float4 VRCSquishFetch(uint texel)
	{
		uint w = max((uint)_SquishData_TexelSize.z, 1u);
		return _SquishData.Load(int3(texel % w, texel / w, 0));
	}

	VRCSquishVertex VRCSquishLoad(uint vertexId)
	{
		float4 t0 = VRCSquishFetch(vertexId * 2);
		float4 t1 = VRCSquishFetch(vertexId * 2 + 1);
		VRCSquishVertex s;
		s.pos = t0.xyz;
		s.normal = VRCSquishOctDecode(t1.xy);
		s.tangent = VRCSquishOctDecode(t1.zw);
		s.region = t0.w < 1.0 ? -1 : (int)floor(t0.w) - 1;
		s.mask = t0.w < 1.0 ? 0.0 : saturate(frac(t0.w) / 0.99);
		return s;
	}

	float4 VRCSquishCam(int region)
	{
		return region == 0 ? _SquishCam0 : region == 1 ? _SquishCam1 : region == 2 ? _SquishCam2 : _SquishCam3;
	}

	float VRCSquishSceneDistance(int region, float4 cam, float2 xy)
	{
		if (cam.x <= 0) return VRCSQUISH_FAR;
		float s = max(_SquishScale, 0.0001);
		float2 uv = xy * s / (2.0 * cam.x) + 0.5;
		if (_SquishFlipY > 0.5) uv.y = 1.0 - uv.y;
		if (any(uv < 0.0) || any(uv > 1.0)) return VRCSQUISH_FAR;

		float tiles = max(_SquishTiles, 1.0);
		float halfTexel = 0.5 * tiles / max(_SquishDepth_TexelSize.z, 1.0);
		uv = clamp(uv, halfTexel, 1.0 - halfTexel);
		float2 tile = tiles > 1.5 ? float2(region & 1, region >> 1) : float2(0, 0);
		float raw = _SquishDepth.SampleLevel(vrcsquish_linear_clamp_sampler, (uv + tile) / tiles, 0).r;

		if (raw <= 0.00001 || raw >= 0.99999) return VRCSQUISH_FAR;
		#if defined(UNITY_REVERSED_Z)
			raw = 1.0 - raw;
		#endif
		return cam.z + raw * (cam.w - cam.z);
	}

	float VRCSquishVertexDistance(float4 cam, float3 p)
	{
		return (p.z + cam.y) * max(_SquishScale, 0.0001);
	}

	float VRCSquishNode(int region, float4 cam, float2 node, float spacing, float vertexDist, float maxDepth, int sub, inout float nearest)
	{
		float sum = 0;
		int count = sub * sub;
		[unroll]
		for (int k = 0; k < count; k++)
		{
			float2 offset = ((float2(k % sub, k / sub) + 0.5) / sub - 0.5) * spacing;
			float pen = vertexDist - VRCSquishSceneDistance(region, cam, node + offset) - _SquishContactThreshold;
			nearest = max(nearest, pen);
			sum += saturate(pen / maxDepth);
		}
		return sum / count;
	}

	float VRCSquishTap(float4 w, int i)
	{
		return dot(w, float4(i == 1, i == 2, i == 3, i == 4));
	}

	float VRCSquishKernel(float4 wx, float4 wy, int x, int y, bool dilate)
	{
		float center = VRCSquishTap(wx, x) * VRCSquishTap(wy, y);
		if (!dilate) return center;
		float side = (VRCSquishTap(wx, x - 1) + VRCSquishTap(wx, x + 1)) * VRCSquishTap(wy, y)
			+ VRCSquishTap(wx, x) * (VRCSquishTap(wy, y - 1) + VRCSquishTap(wy, y + 1));
		return 0.5 * center + 0.125 * side;
	}

	void VRCSquishGrid(int region, float4 cam, float2 xy, float vertexDist, float spacing, bool dilate, int sub, out float value, out float2 grad, inout float nearest)
	{
		float2 q = xy / spacing;
		float2 cell = floor(q);
		float2 f = q - cell;
		float4 wx, dwx, wy, dwy;
		VRCSquishBSpline(f.x, wx, dwx);
		VRCSquishBSpline(f.y, wy, dwy);
		float maxDepth = max(_SquishMaxDepth, 0.00001);
		int reach = dilate ? 1 : 0;

		value = 0;
		grad = 0;
		[loop]
		for (int n = 0; n < 36; n++)
		{
			int x = n % 6;
			int y = n / 6;
			int outside = (x < 1 || x > 4 ? 1 : 0) + (y < 1 || y > 4 ? 1 : 0);
			if (outside > reach) continue;

			float v = VRCSquishNode(region, cam, (cell + float2(x - 2, y - 2)) * spacing, spacing, vertexDist, maxDepth, sub, nearest);
			value += VRCSquishKernel(wx, wy, x, y, dilate) * v;
			grad += float2(VRCSquishKernel(dwx, wy, x, y, dilate), VRCSquishKernel(wx, dwy, x, y, dilate)) * v;
		}
		grad /= spacing;
	}

	VRCSquishField VRCSquishSampleField(int region, float4 cam, float3 p)
	{
		float spacing = max(_SquishSoftness, 0.002) * 0.5;
		float vertexDist = VRCSquishVertexDistance(cam, p);
		VRCSquishField field;
		field.nearest = VRCSQUISH_NONE;
		field.disp = 0;
		field.grad = 0;

		float k = _SquishBulge * 0.5;
		float wide = 0;
		float2 gWide = 0;
		if (k != 0) VRCSquishGrid(region, cam, p.xy, vertexDist, spacing * 2.0, false, 1, wide, gWide, field.nearest);

		float probe;
		float2 gProbe;
		VRCSquishGrid(region, cam, p.xy, vertexDist, spacing, true, 2, probe, gProbe, field.nearest);
		if (field.nearest <= 0) return field;

		float b;
		float2 gb;
		VRCSquishGrid(region, cam, p.xy, vertexDist, spacing, true, 4, b, gb, field.nearest);

		float ob = 1.0 - b;
		float dent = 1.0 - ob * ob * ob;
		float2 gDent = 3.0 * ob * ob * gb;

		float open = 1.0 - dent;
		float bulge = k * wide * open * open;
		float2 gBulge = k * (gWide * open * open - wide * 2.0 * open * gDent);

		float maxDepth = max(_SquishMaxDepth, 0.00001);
		field.disp = (dent - bulge) * maxDepth;
		field.grad = (gDent - gBulge) * maxDepth;
		return field;
	}

	bool VRCSquishDeform(VRCSquishVertex s, inout float4 vertex, inout float3 normal, float4 tangent)
	{
		if (s.region < 0 || s.mask <= 0) return false;
		if (VRCSquishIsRegionCamera(s.region)) return true;
		if (_SquishOn < 0.5) return false;

		float4 cam = VRCSquishCam(s.region);
		float weight = s.mask * _SquishStrength;
		if (weight == 0) return false;
		VRCSquishField field = VRCSquishSampleField(s.region, cam, s.pos);
		float d0 = field.disp * weight;
		if (abs(d0) < 0.000001) return false;

		bool hasTangent = dot(tangent.xyz, tangent.xyz) > 0.000001;
		float tangentSign = tangent.w < 0 ? -1.0 : 1.0;
		float3 objN = normalize(normal);
		float3 objT = hasTangent ? normalize(tangent.xyz) : float3(0, 0, 0);
		float3 objB = cross(objN, objT) * tangentSign;
		float3 restB = cross(s.normal, s.tangent) * tangentSign;

		float3 push = float3(0, 0, -1);
		float3 pushObj = hasTangent
			? dot(push, s.tangent) * objT + dot(push, restB) * objB + dot(push, s.normal) * objN
			: -objN;
		float3 pushWorld = normalize(mul((float3x3)unity_ObjectToWorld, pushObj));
		vertex.xyz += mul((float3x3)unity_WorldToObject, pushWorld * d0);

		if (_SquishNormals > 0 && hasTangent)
		{
			float2 slope = field.grad * weight / max(_SquishScale, 0.0001);
			float gT = clamp(dot(slope, s.tangent.xy), -2.0, 2.0);
			float gB = clamp(dot(slope, restB.xy), -2.0, 2.0);
			float3 z = float3(0, 0, 1);
			float3 n2 = normalize(cross(s.tangent - z * gT, restB - z * gB));
			if (dot(n2, s.normal) < 0) n2 = -n2;
			float3 nObj = dot(n2, s.tangent) * objT + dot(n2, restB) * objB + dot(n2, s.normal) * objN;
			normal = normalize(lerp(objN, normalize(nObj), _SquishNormals));
		}
		return false;
	}

	bool applySquish(inout appdata v)
	{
		return VRCSquishDeform(VRCSquishLoad(v.vertexId), v.vertex, v.normal, v.tangent);
	}

	VRCSquishVertex VRCSquishInterpolate(VRCSquishVertex a, VRCSquishVertex b, VRCSquishVertex c, float3 bary)
	{
		VRCSquishVertex main = a;
		if (b.mask > main.mask) main = b;
		if (c.mask > main.mask) main = c;

		VRCSquishVertex s = main;
		if (main.region < 0) return s;
		if (a.region != main.region) { a = main; a.mask = 0; }
		if (b.region != main.region) { b = main; b.mask = 0; }
		if (c.region != main.region) { c = main; c.mask = 0; }

		s.pos = a.pos * bary.x + b.pos * bary.y + c.pos * bary.z;
		s.normal = normalize(a.normal * bary.x + b.normal * bary.y + c.normal * bary.z);
		s.tangent = normalize(a.tangent * bary.x + b.tangent * bary.y + c.tangent * bary.z);
		s.mask = a.mask * bary.x + b.mask * bary.y + c.mask * bary.z;
		return s;
	}

	float VRCSquishNearest(int region, float3 p)
	{
		float4 cam = VRCSquishCam(region);
		float nearest = VRCSQUISH_NONE;
		float value;
		float2 grad;
		VRCSquishGrid(region, cam, p.xy, VRCSquishVertexDistance(cam, p), max(_SquishSoftness, 0.002), false, 1, value, grad, nearest);
		return nearest;
	}

	float VRCSquishEdgeCap(VRCSquishVertex a, VRCSquishVertex b)
	{
		if (a.region < 0 || a.region != b.region) return 1.0;
		float len = length(a.pos - b.pos) * max(_SquishScale, 0.0001);
		return clamp(len / max(_SquishTessEdge, 0.0005), 1.0, max(_SquishTessMax, 1.0));
	}

	float VRCSquishEdgeFactor(float cap, float nearA, float nearB)
	{
		float reach = max(_SquishTessReach, 0.0001);
		float t = saturate((max(nearA, nearB) + reach) / reach);
		return lerp(1.0, cap, t * t);
	}

	float4 VRCSquishTessFactors(uint id0, uint id1, uint id2)
	{
		if (_SquishOn < 0.5) return 1;
		VRCSquishVertex a = VRCSquishLoad(id0);
		VRCSquishVertex b = VRCSquishLoad(id1);
		VRCSquishVertex c = VRCSquishLoad(id2);

		float3 cap = float3(VRCSquishEdgeCap(b, c), VRCSquishEdgeCap(c, a), VRCSquishEdgeCap(a, b));
		if (all(cap <= 1.01)) return 1;

		float nearA = (cap.y > 1.01 || cap.z > 1.01) ? VRCSquishNearest(a.region, a.pos) : VRCSQUISH_NONE;
		float nearB = (cap.x > 1.01 || cap.z > 1.01) ? VRCSquishNearest(b.region, b.pos) : VRCSQUISH_NONE;
		float nearC = (cap.x > 1.01 || cap.y > 1.01) ? VRCSquishNearest(c.region, c.pos) : VRCSQUISH_NONE;

		float4 f;
		f.x = VRCSquishEdgeFactor(cap.x, nearB, nearC);
		f.y = VRCSquishEdgeFactor(cap.y, nearC, nearA);
		f.z = VRCSquishEdgeFactor(cap.z, nearA, nearB);
		f.w = max(f.x, max(f.y, f.z));
		return f;
	}
#endif
